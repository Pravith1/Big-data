meta {
  name: Get Player Training
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/players/getPlayerTraining/P101
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.data: isDefined
}

tests {
  test("returns player training sessions", function() {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.success).to.be.true;
    expect(body.data).to.be.an('array');
  });
}
