meta {
  name: Get Coach Player Training
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/players/getCoachPlayerTraining?coachId=C101
  body: none
  auth: none
}

params:query {
  coachId: C101
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.coach: eq C101
  res.body.data: isDefined
}

tests {
  test("cross-database query returns coached players with training sessions", function() {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.success).to.be.true;
    expect(body.data).to.be.an('array');
    if (body.data.length > 0) {
      expect(body.data[0]).to.have.property('trainingSessions');
    }
  });
}
