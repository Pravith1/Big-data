meta {
  name: Create Player
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/players/createPlayer
  body: json
  auth: none
}

body:json {
  {
    "_id": "P999",
    "name": "Alex Hunter",
    "age": 22,
    "gender": "Male",
    "sport": "Football",
    "position": "Striker",
    "contact": {
      "email": "alex@example.com",
      "phone": "9876543299"
    }
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
  res.body.data._id: eq P999
}

tests {
  test("creates player validated via XML schema", function() {
    expect(res.getStatus()).to.equal(201);
    const body = res.getBody();
    expect(body.success).to.be.true;
    expect(body.data._id).to.equal('P999');
    expect(body.data.name).to.equal('Alex Hunter');
  });
}
