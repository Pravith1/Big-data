# MongoDB Atlas - replace <db_password> with your Atlas database user's password
# (URL-encode it if it contains special characters like @ : / ? #)
MONGO_URI=mongodb+srv://trishajanath:<db_password>@cluster0.ua8jxif.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGO_DB=smart_sports

# Neo4j - Aura gives a URI like neo4j+s://xxxxxxxx.databases.neo4j.io
# For Neo4j Desktop / local use bolt://localhost:7687
NEO4J_URI=neo4j+s://<your-instance-id>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=<neo4j_password>
