meta {
  name: Assign Player to Training Center
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/relationships/player-training-center
  body: json
  auth: none
}

body:json {
  {
    "playerId": "P101",
    "trainingCenterId": "TC01"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.data.relationship: eq TRAINS_AT
}

tests {
  test("creates TRAINS_AT relationship in Neo4j", function() {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.success).to.be.true;
    expect(body.data.relationship).to.equal('TRAINS_AT');
  });
}
